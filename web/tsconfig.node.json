{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noUnusedLocals": true, "skipLibCheck": true, "noEmit": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true, "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "tests", "server", "shared", "src/data"]
}
